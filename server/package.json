{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend foundation for Maatram Foundation Student & Volunteer Management System",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "build": "tsc --project tsconfig.json && tsc-alias",
    "start": "node dist/index.js",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.ts\"",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "test:phase4": "ts-node -r tsconfig-paths/register src/tests/test_phase4.ts",
    "test:phase5": "ts-node -r tsconfig-paths/register src/tests/test_phase5.ts",
    "test:phase8_2": "ts-node -r tsconfig-paths/register src/tests/test_phase8_2.ts",
    "test:phase8_3": "ts-node -r tsconfig-paths/register src/tests/test_phase8_3.ts",
    "test:phase8_4": "ts-node -r tsconfig-paths/register src/tests/test_phase8_4.ts",
    "test:phase8_5": "ts-node -r tsconfig-paths/register src/tests/test_phase8_5.ts",
    "test:phase10_1": "ts-node -r tsconfig-paths/register src/tests/test_phase10_1.ts",
    "test:phase10_2": "ts-node -r tsconfig-paths/register src/tests/test_phase10_2.ts",
    "test:complete": "ts-node -r tsconfig-paths/register src/tests/test_backend_complete.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.12.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.3"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }
}
